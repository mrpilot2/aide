@PACKAGE_INIT@

find_dependency(spdlog)
find_dependency(fmt)

include("${CMAKE_CURRENT_LIST_DIR}/AideQt@QT_VERSION_MAJOR@Targets.cmake")

# Create versionless targets
add_library(Aide::AideApplication INTERFACE IMPORTED)

set_target_properties(
  Aide::AideApplication
  PROPERTIES INTERFACE_LINK_LIBRARIES Aide::AideQt@QT_VERSION_MAJOR@Application
)

add_library(Aide::AideWidgets INTERFACE IMPORTED)

set_target_properties(
  Aide::AideWidgets
  PROPERTIES INTERFACE_LINK_LIBRARIES Aide::AideQt@QT_VERSION_MAJOR@Widgets
)

include(CMakeFindDependencyMacro)

find_dependency(
  Qt@QT_VERSION_MAJOR@
  6.5
  COMPONENTS
  Core
  Widgets
)
